{
	FLESH,
	SOULS,
	IRON,
	COUNT
}

enum UNIT_FACTION
{
	NOONE,
	FRIENDLY,
	ENEMY
}

enum DAY_PHASE
{
	DAY,
	NIGHT
}

enum CULTIST_STAT
{
	BODY,
	SPIRIT,
	FERVOR,
	COUNT
}

enum CULTIST_LEVEL_REWARD
{
	ATTRIBUTE,
	PASSIVE,
	ACTIVE
}

enum DEMON_TYPE
{
	NONE,
	IMP,
	WARLOCK,
	BRUTE
}

