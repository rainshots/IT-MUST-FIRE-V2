draw_set_color(corruption_shell ? COLOR_CORRUPTION_SHELL : (hell_shell ? COLOR_CANNON_FIRE : COLOR_CANNON_NORMAL));
draw_circle(x, y, 22, false);
draw_set_color(COLOR_HUD_TEXT);
draw_circle(x, y, 22, true);
draw_set_halign(fa_center);
draw_set_valign(fa_bottom);
draw_text_transformed(x, y - 26, corruption_shell ? "Corruption Shell" : (hell_shell ? "Hell Shell" : "Exploding Shell"), 0.5, 0.5, 0);
draw_set_halign(fa_left);
draw_set_valign(fa_top);
draw_set_color(c_white);
