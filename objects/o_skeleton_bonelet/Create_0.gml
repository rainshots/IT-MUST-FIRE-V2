// Initialize shared Skeleton state and behavior.
event_inherited();

// Bonelet combat stats.
max_hp = BALANCE_SKELETON_BONELET_HP;
hp = max_hp;
armor = BALANCE_SKELETON_BONELET_ARMOR;
magic_resistance = BALANCE_SKELETON_BONELET_MAGIC_RESISTANCE;
damage = BALANCE_SKELETON_BONELET_DAMAGE;
magic_damage = 0;
reload_time = BALANCE_SKELETON_BONELET_RELOAD_TIME * room_speed;
attack_radius = BALANCE_SKELETON_BONELET_ATTACK_RADIUS;
move_speed = BALANCE_SKELETON_BONELET_MOVE_SPEED;
